# Rutas relativas a `backend/`, apuntando a `backend/data/` — copias locales
# de los datasets generados por el pipeline de Visualizacion-de-datos (Fase de
# organización de monorepo: ya no se leen desde ../Visualizacion-de-datos/,
# para que backend/ sea desplegable de forma autocontenida, p. ej. en Railway).
# Copia este archivo a .env; normalmente no hace falta tocar las rutas.

# bloque_1 — integración PM2.5 x cobertura arbórea (una fila por comuna/periodo)
DATA_INTEGRACION_PM25_ARBOLES=./data/integracion_v2_pm25_arboles_medellin.csv

# bloque_1 — trazabilidad del spatial join estación SIATA -> comuna
DATA_AUDITORIA_ESTACIONES_COMUNAS=./data/auditoria_estaciones_comunas.csv

# bloque_1 — relaciones anuales comuna x vulnerabilidad, insumo del recomendador
DATA_RELACIONES_BLOQUE2=./data/relaciones_v2_bloque2.csv

# bloque_2 — recomendación de siembra por zona verde (~1.649 filas)
DATA_RECOMENDACION_SIEMBRA_ZONA=./data/recomendacion_siembra_por_zona.csv

# bloque_2 — resumen de recomendación agregado por comuna (score AHP)
DATA_RESUMEN_RECOMENDACION_COMUNA=./data/resumen_recomendacion_por_comuna.csv

# bloque_2 — geometría de zonas priorizadas para siembra (GeoJSON)
DATA_ZONAS_PRIORIZADAS_SIEMBRA=./data/zonas_priorizadas_siembra.geojson

# límite catastral de las 16 comunas + corregimientos de Medellín (GeoJSON)
DATA_LIMITE_CATASTRAL_COMUNAS=./data/limite_catastral_de_comun.geojson

# Inventario completo de zonas verdes (GeoJSON). NO existe todavía en el repo
# de datos (ver backend/README.md, sección "Dataset pendiente"). El endpoint
# /api/zonas-verdes responde 503 mientras esta ruta no apunte a un archivo real.
DATA_INVENTARIO_ZONAS_VERDES=./data/inventario_zonas_verdes.geojson

# Serie horaria SIATA por estación (una columna por código de estación). Se usa
# para exponer la última lectura real por estación en /api/pm25/estaciones.
DATA_SOLICITUD_PM25_ESTACIONES=./data/Solicitud_PM25_DP1763941.csv

# Orígenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
